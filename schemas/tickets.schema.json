{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anvil ticket document",
  "description": "Version 1 ticket input with optional preparation provenance. Anvil also validates task ID uniqueness, dependency references and acyclicity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tasks"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator",
        "generator_version",
        "source",
        "source_sha256",
        "repo_head",
        "prepared_at",
        "agent"
      ],
      "properties": {
        "generator": {"$ref": "#/$defs/text"},
        "generator_version": {"$ref": "#/$defs/text"},
        "source": {"$ref": "#/$defs/text"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "repo_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "prepared_at": {"type": "string", "format": "date-time"},
        "agent": {"enum": ["codex", "claude-code", "muse"]},
        "model": {"$ref": "#/$defs/text", "description": "The explicit model the preparation turn selected, when one was given."},
        "gate": {
          "description": "The adversarial readiness gate that judged this graph before it was written, or null when the operator disabled it.",
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["agent", "distinct_adapter", "questions"],
              "properties": {
                "agent": {"enum": ["codex", "claude-code", "muse"]},
                "model": {"$ref": "#/$defs/text"},
                "distinct_adapter": {"type": "boolean"},
                "questions": {"type": "integer", "const": 0}
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": {
        "pattern": "\u0000"
      }
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9]",
      "not": {
        "pattern": "[^A-Za-z0-9._-]"
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "objective",
        "depends_on",
        "acceptance_criteria"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "objective": {
          "$ref": "#/$defs/text"
        },
        "worker": {
          "$ref": "#/$defs/id",
          "description": "Pin this task to a configured worker ID; omission allows any available worker."
        },
        "resources": {
          "type": "array",
          "uniqueItems": true,
          "description": "Named resources held from dispatch through integration. Tasks sharing a resource cannot overlap.",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "exclusive": {
          "type": "boolean",
          "default": false,
          "description": "Run without any other active task, holding exclusivity through integration."
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "description": "AI Hero skills to pin from the repository's managed installation and supply to this ticket's implementation turn.",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Sections or requirements in the source specification that justify this ticket.",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "profile": {
          "$ref": "#/$defs/id"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "execution": {
          "type": "object",
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "run_id": {
              "$ref": "#/$defs/text"
            },
            "attempt_id": {
              "$ref": "#/$defs/text"
            },
            "worker": {
              "$ref": "#/$defs/text"
            },
            "updated_at": {
              "$ref": "#/$defs/text"
            },
            "reason": {
              "$ref": "#/$defs/text"
            },
            "evidence": {
              "$ref": "#/$defs/text"
            },
            "candidate_sha": {
              "$ref": "#/$defs/text"
            },
            "integrated_sha": {
              "$ref": "#/$defs/text"
            },
            "status": {
              "enum": [
                "todo",
                "in_progress",
                "ready_for_review",
                "in_review",
                "verifying",
                "done",
                "blocked",
                "failed",
                "interrupted"
              ]
            },
            "event_id": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
