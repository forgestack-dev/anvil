{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anvil ticket document",
  "description": "Version 1 ticket input. Anvil also validates task ID uniqueness, dependency references and acyclicity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "tasks"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": {
        "pattern": "\u0000"
      }
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9]",
      "not": {
        "pattern": "[^A-Za-z0-9._-]"
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "objective",
        "depends_on",
        "acceptance_criteria"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "objective": {
          "$ref": "#/$defs/text"
        },
        "worker": {
          "$ref": "#/$defs/id",
          "description": "Pin this task to a configured worker ID; omission allows any available worker."
        },
        "resources": {
          "type": "array",
          "uniqueItems": true,
          "description": "Named resources held from dispatch through integration. Tasks sharing a resource cannot overlap.",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "exclusive": {
          "type": "boolean",
          "default": false,
          "description": "Run without any other active task, holding exclusivity through integration."
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "profile": {
          "$ref": "#/$defs/id"
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "execution": {
          "type": "object",
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "run_id": {
              "$ref": "#/$defs/text"
            },
            "attempt_id": {
              "$ref": "#/$defs/text"
            },
            "worker": {
              "$ref": "#/$defs/text"
            },
            "updated_at": {
              "$ref": "#/$defs/text"
            },
            "reason": {
              "$ref": "#/$defs/text"
            },
            "evidence": {
              "$ref": "#/$defs/text"
            },
            "candidate_sha": {
              "$ref": "#/$defs/text"
            },
            "integrated_sha": {
              "$ref": "#/$defs/text"
            },
            "status": {
              "enum": [
                "todo",
                "in_progress",
                "ready_for_review",
                "in_review",
                "verifying",
                "done",
                "blocked",
                "failed",
                "interrupted"
              ]
            },
            "event_id": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
