{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anvil run configuration",
  "description": "Paths are relative to this file. Verification commands are trusted argv arrays executed without an implicit shell. Worker IDs must be unique; Anvil validates that constraint at runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "repo",
    "tickets",
    "verification"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "repo": {
      "$ref": "#/$defs/text"
    },
    "tickets": {
      "$ref": "#/$defs/text"
    },
    "state_dir": {
      "$ref": "#/$defs/text"
    },
    "agent": {
      "type": "string",
      "enum": [
        "codex",
        "claude-code",
        "muse"
      ],
      "default": "codex"
    },
    "agent_binary": {
      "$ref": "#/$defs/text",
      "description": "Trusted executable override. Defaults to codex or claude for the selected CLI agent; unused for muse, whose turns are fulfilled by the operator."
    },
    "codex_binary": {
      "$ref": "#/$defs/text",
      "description": "Legacy Codex executable override. Cannot be used with agent_binary or the claude-code agent."
    },
    "agent_timeout": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "check_timeout": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "workers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "description": "Named worker slots. With workers configured, the top-level agent selects the independent reviewer.",
      "items": {
        "$ref": "#/$defs/worker"
      }
    },
    "max_processes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "description": "Concurrent managed command limit, including agents, review, verification and supervisor Git commands. Requires workers and defaults to the number of worker slots."
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "\u0000"
          }
        }
      }
    },
    "ticket_status": {
      "type": "boolean",
      "default": false
    },
    "skill_selection": {
      "type": "object",
      "description": "Opt-in deterministic selection for tickets whose skills array is empty. Explicit ticket skills remain unchanged.",
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "rules"
        },
        "max_skills": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "default": 2
        }
      }
    },
    "adaptive": {
      "type": "object",
      "required": [
        "profiles",
        "defaults",
        "review_profile"
      ],
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "agent",
              "model",
              "effort",
              "rank"
            ],
            "additionalProperties": false,
            "properties": {
              "agent": {
                "enum": [
                  "codex",
                  "claude-code"
                ]
              },
              "model": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
              },
              "effort": {
                "type": "string"
              },
              "rank": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "price": {
                "type": "object",
                "required": [
                  "version",
                  "input",
                  "cached_input",
                  "cache_write",
                  "output"
                ],
                "additionalProperties": false,
                "properties": {
                  "version": {
                    "$ref": "#/$defs/text"
                  },
                  "input": {
                    "type": "number",
                    "minimum": 0
                  },
                  "cached_input": {
                    "type": "number",
                    "minimum": 0
                  },
                  "cache_write": {
                    "type": "number",
                    "minimum": 0
                  },
                  "output": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "reserve_usd": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "max_budget_usd": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "agent": {
                      "const": "codex"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "effort": {
                      "enum": [
                        "none",
                        "minimal",
                        "low",
                        "medium",
                        "high",
                        "xhigh",
                        "max",
                        "ultra"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "agent": {
                      "const": "claude-code"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "effort": {
                      "enum": [
                        "low",
                        "medium",
                        "high",
                        "xhigh",
                        "max",
                        "ultracode"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "max_budget_usd"
                  ]
                },
                "then": {
                  "properties": {
                    "agent": {
                      "const": "claude-code"
                    }
                  }
                }
              }
            ]
          }
        },
        "defaults": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/id"
          }
        },
        "review_profile": {
          "$ref": "#/$defs/id"
        },
        "mode": {
          "enum": [
            "off",
            "shadow",
            "rules",
            "adaptive"
          ]
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "max_invocations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "policy": {
          "$ref": "#/$defs/id"
        },
        "soft_budget_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "learning": {
          "type": "object",
          "required": [
            "min_samples",
            "max_quality_loss",
            "min_cost_improvement",
            "max_latency_ratio"
          ],
          "additionalProperties": false,
          "properties": {
            "min_samples": {
              "type": "integer",
              "minimum": 5
            },
            "max_quality_loss": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1
            },
            "min_cost_improvement": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 1
            },
            "max_latency_ratio": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "auto_promote": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "agent_turns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "description": "Maximum agentic turns per Claude Code invocation; other adapters ignore it. Defaults to the adapter's own limit."
    },
    "orientation": {
      "type": "string",
      "minLength": 1,
      "description": "Path to a UTF-8 repository orientation file supplied verbatim in implementation prompts so workers do not spend turns locating context."
    }
  },
  "allOf": [
    {
      "not": {
        "required": [
          "codex_binary",
          "agent_binary"
        ]
      }
    },
    {
      "if": {
        "required": [
          "agent"
        ],
        "properties": {
          "agent": {
            "const": "claude-code"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "codex_binary"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "max_processes"
        ]
      },
      "then": {
        "required": [
          "workers"
        ]
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": {
        "pattern": "\u0000"
      }
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9]",
      "not": {
        "pattern": "[^A-Za-z0-9._-]"
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "agent"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "agent": {
          "type": "string",
          "enum": [
            "codex",
            "claude-code",
            "muse"
          ]
        },
        "agent_binary": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
