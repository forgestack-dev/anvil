{"uid": "delivery-dashboard.json:integration-journal-schema:1", "file": "delivery-dashboard.json", "task": "integration-journal-schema", "index": 1, "text": "A versioned per-run integration journal is created beside the execution ledger with its own schema version and migration check.", "procedure": "execution", "unbounded_absence": false, "joins_claims": true, "self_gradable": false, "labeled_by": "model-proposed"}
{"uid": "delivery-dashboard.json:integration-journal-schema:2", "file": "delivery-dashboard.json", "task": "integration-journal-schema", "index": 2, "text": "Only the integration coordinator writes the journal, under an OS advisory lock; it never writes execution state, and both databases can be opened read-only at once.", "procedure": "reading", "unbounded_absence": true, "joins_claims": true, "self_gradable": false, "labeled_by": "model-proposed"}
{"uid": "delivery-dashboard.json:integration-journal-schema:3", "file": "delivery-dashboard.json", "task": "integration-journal-schema", "index": 3, "text": "Records exist for frozen configuration, delivery, issue binding, group, and group membership.", "procedure": "reading", "unbounded_absence": false, "joins_claims": false, "self_gradable": false, "labeled_by": "model-proposed"}
{"uid": "delivery-dashboard.json:integration-journal-schema:4", "file": "delivery-dashboard.json", "task": "integration-journal-schema", "index": 4, "text": "A run without integrations configured creates no journal and behaves exactly as before.", "procedure": "execution", "unbounded_absence": false, "joins_claims": true, "self_gradable": false, "labeled_by": "model-proposed"}
{"uid": "delivery-dashboard.json:event-projection-and-outbox:1", "file": "delivery-dashboard.json", "task": "event-projection-and-outbox", "index": 1, "text": "Committed execution events project into outbox intents and the projection cursor advances in the same journal transaction.", "procedure": "reading", "unbounded_absence": false, "joins_claims": false, "self_gradable": false, "labeled_by": "model-proposed"}
